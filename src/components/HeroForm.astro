---
// src/components/HeroForm.astro — the home page's comparator form (works without JS: GET to /compare)
import { t, localePath } from '../i18n/utils';
import { loadCountries } from '../lib/data-loader';
import type { Lang, Country } from '../lib/types';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const countries = loadCountries();

const countryName = (c: Country): string => c[`name_${lang}` as keyof Country] as string;

const supportedCodes = countries.map((c) => c.code);
const useCountryTemplate = t(lang, 'ui.use_country', { country: '{country}' });
---

<form class="card ship-form" action={localePath(lang, '/compare')} method="get" aria-labelledby="ship-form-title">
  <h2 class="ship-form__title" id="ship-form-title">{t(lang, 'ui.your_shipment')}</h2>

  <div class="ship-form__row">
    <fieldset class="field">
      <legend class="field__label">{t(lang, 'form.type')}</legend>
      <div class="segmented">
        <label class="segmented__opt">
          <input type="radio" name="type" value="letter" checked />
          {t(lang, 'form.letter')}
        </label>
        <label class="segmented__opt">
          <input type="radio" name="type" value="parcel" />
          {t(lang, 'form.parcel')}
        </label>
      </div>
    </fieldset>

    <div class="field">
      <label class="field__label" for="hero-weight">{t(lang, 'form.weight')}</label>
      <div class="unit-input">
        <input id="hero-weight" name="weight" type="number" inputmode="decimal" class="input" aria-describedby="hero-weight-unit" value="20" min="1" max="2000" step="1" />
        <span class="unit-input__unit" id="hero-weight-unit">g</span>
      </div>
    </div>
  </div>

  <div class="field">
    <label class="field__label" for="hero-origin">{t(lang, 'form.origin')}</label>
    <select id="hero-origin" name="origin" class="select">
      <option value="all">{t(lang, 'form.all_countries')}</option>
      {countries.map((c) => <option value={c.code}>{countryName(c)}</option>)}
    </select>
    <button type="button" class="country-hint" data-for="hero-origin" hidden></button>
  </div>

  <div class="field">
    <label class="field__label" for="hero-destination">{t(lang, 'form.destination')}</label>
    <select id="hero-destination" name="destination" class="select">
      <option value="domestic">{t(lang, 'form.domestic')}</option>
      {countries.map((c) => <option value={c.code}>{countryName(c)}</option>)}
    </select>
  </div>

  <button type="submit" class="btn btn--primary ship-form__submit">
    {t(lang, 'hero.cta')}
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
</form>

<script define:vars={{ supportedCodes, useCountryTemplate }}>
  // Offer the visitor's own country (from the browser language) as a one-tap choice
  (function () {
    const parts = (navigator.language || '').split('-');
    let code = '';
    if (parts.length >= 2) {
      code = parts[1].toUpperCase();
    } else {
      const map = { fr:'FR',de:'DE',es:'ES',it:'IT',nl:'NL',pt:'PT',pl:'PL',ro:'RO',hu:'HU',el:'GR',bg:'BG',hr:'HR',sk:'SK',sl:'SI',lt:'LT',lv:'LV',et:'EE',fi:'FI',sv:'SE',da:'DK',no:'NO',is:'IS',en:'GB' };
      code = map[parts[0].toLowerCase()] || '';
    }
    if (!code || !supportedCodes.includes(code)) return;

    document.querySelectorAll('.ship-form .country-hint').forEach(function (hint) {
      const select = document.getElementById(hint.dataset.for);
      const opt = select && select.querySelector('option[value="' + code + '"]');
      if (!opt) return;
      hint.textContent = useCountryTemplate.replace('{country}', opt.textContent.trim());
      hint.hidden = false;
      hint.addEventListener('click', function () {
        select.value = code;
        hint.hidden = true;
        select.focus();
      });
    });
  })();

  // Letter / parcel: switch the weight unit and limits
  (function () {
    const weight = document.getElementById('hero-weight');
    const unit = document.getElementById('hero-weight-unit');
    if (!weight || !unit) return;
    document.querySelectorAll('.ship-form input[name="type"]').forEach(function (radio) {
      radio.addEventListener('change', function () {
        const parcel = this.value === 'parcel';
        weight.value = parcel ? '1' : '20';
        weight.min = parcel ? '0.1' : '1';
        weight.max = parcel ? '50' : '2000';
        weight.step = parcel ? '0.1' : '1';
        unit.textContent = parcel ? 'kg' : 'g';
      });
    });
  })();
</script>
