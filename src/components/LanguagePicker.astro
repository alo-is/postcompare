---
// src/components/LanguagePicker.astro
import { languages, languageCodes, languageNames, t } from '../i18n/utils';
import type { Lang } from '../lib/types';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
---

<ul class="lang-picker" aria-label={t(lang, 'ui.language')}>
  {languages.map((l) => (
    <li>
      <a
        href={`/${l}${currentPath || '/'}`}
        class="lang-picker__link"
        hreflang={l}
        lang={l}
        aria-current={l === lang ? 'true' : undefined}
        aria-label={`${languageCodes[l]}, ${languageNames[l]}`}
      >{languageCodes[l]}</a>
    </li>
  ))}
</ul>
