---
// src/pages/[lang]/operator/[id].astro
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Flag from '../../../components/Flag.astro';
import RateTable from '../../../components/RateTable.astro';
import { t, localePath } from '../../../i18n/utils';
import { formatDate, formatPrice } from '../../../i18n/format';
import { loadAllOperators, loadCountries, getOperatorIds, loadPostalChanges } from '../../../lib/data-loader';
import type { Lang, Country } from '../../../lib/types';

export function getStaticPaths() {
  const langs: Lang[] = ['fr', 'en', 'de'];
  const ids = getOperatorIds();

  return langs.flatMap((lang) =>
    ids.map((id) => ({
      params: { lang, id },
    })),
  );
}

const lang = Astro.params.lang as Lang;
const operatorId = Astro.params.id;

const operators = loadAllOperators();
const operator = operators.find((op) => op.operator.id === operatorId);
const countries = loadCountries();

if (!operator) {
  return Astro.redirect(localePath(lang, '/'));
}

const info = operator.operator;
const lettersAvailable = operator.letters.available !== false;
const postalAnnouncement = loadPostalChanges().announcements.find(
  ({ operator_id, scope }) => operator_id === info.id && scope === 'consumer',
);

const getCountry = (code: string): Country | undefined =>
  countries.find((c) => c.code === code);

const countryName = (code: string): string => {
  const c = getCountry(code);
  if (!c) return code;
  return c[`name_${lang}` as keyof Country] as string;
};


// Find cheapest rates in each section (no letter price when the service is withdrawn)
const cheapestDomesticLetter = lettersAvailable
  ? operator.letters.domestic.reduce(
    (min, r) => (r.price_eur < min.price_eur ? r : min),
    operator.letters.domestic[0],
  )
  : undefined;
const cheapestDomesticParcel = operator.parcels.domestic.reduce(
  (min, r) => (r.price_eur < min.price_eur ? r : min),
  operator.parcels.domestic[0],
);

const lowestLetterPrice = cheapestDomesticLetter?.price_eur;
const lowestParcelPrice = cheapestDomesticParcel?.price_eur ?? Infinity;

// Build JSON-LD for the operator (Service schema)
const operatorJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `${info.name} - Postal Services`,
  "provider": {
    "@type": "Organization",
    "name": info.name,
    "url": info.website,
  },
  "url": new URL(`/${lang}/operator/${info.id}/`, Astro.site).href,
  "areaServed": { "@type": "Country", "name": countryName(info.country) },
  "serviceType": "Postal Service",
  "offers": [
    ...(lowestLetterPrice !== undefined ? [{
      "@type": "Offer",
      "name": "Domestic Letter",
      "priceCurrency": "EUR",
      "price": lowestLetterPrice.toFixed(2),
    }] : []),
    {
      "@type": "Offer",
      "name": "Domestic Parcel",
      "priceCurrency": "EUR",
      "price": lowestParcelPrice.toFixed(2),
    },
  ],
};

const operatorDescription = lettersAvailable
  ? t(lang, 'meta.operator_description', {
    name: info.name,
    country: countryName(info.country),
    letter: lowestLetterPrice!.toFixed(2),
    parcel: lowestParcelPrice.toFixed(2),
  })
  : t(lang, 'meta.operator_description_no_letters', {
    name: info.name,
    country: countryName(info.country),
    parcel: lowestParcelPrice.toFixed(2),
  });

---

<BaseLayout
  title={t(lang, 'meta.operator_title', { name: info.name, country: countryName(info.country) })}
  description={operatorDescription}
  lang={lang}
  breadcrumbs={[{ name: info.name, path: `/operator/${info.id}` }]}
  jsonLd={operatorJsonLd}
>
  <article class="wrap op-page">
    <p class="op-back">
      <a href={localePath(lang, '/compare')} class="link">
        <span aria-hidden="true">&larr;</span> {t(lang, 'operator.back_home')}
      </a>
    </p>

    <header class="op-head">
      <div class="op-head__id">
        <Flag code={info.country} size="lg" />
        <div class="op-head__text">
          <h1>{info.name}</h1>
          <p class="op-head__meta">
            <span>{countryName(info.country)}</span>
            <span>{t(lang, 'operator.last_updated')}: <span class="num">{info.last_updated}</span></span>
          </p>
        </div>
      </div>

      <dl class="op-stats">
        <div class:list={['card', 'op-stat', 'stamp', { 'op-stat--unavailable': !lettersAvailable }]}>
          <dt>{t(lang, 'form.letter')}</dt>
          {lowestLetterPrice !== undefined ? (
            <dd><span class="op-stat__from">{t(lang, 'ui.from')}</span> <span class="num">{formatPrice(lang, lowestLetterPrice)}</span></dd>
          ) : (
            <dd class="op-stat__none">{t(lang, 'operator.letters_unavailable_short')}</dd>
          )}
        </div>
        <div class="card op-stat stamp">
          <dt>{t(lang, 'form.parcel')}</dt>
          <dd><span class="op-stat__from">{t(lang, 'ui.from')}</span> <span class="num">{formatPrice(lang, lowestParcelPrice)}</span></dd>
        </div>
      </dl>

      <div class="btn-row op-head__actions">
        <a href={localePath(lang, `/compare?origin=${info.country}`)} class="btn btn--primary">
          {t(lang, 'operator.compare_cta')}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href={info.website} target="_blank" rel="noopener" class="btn btn--secondary">
          {t(lang, 'operator.website')}
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M6 3H3v10h10v-3M9 2h5v5M14 2L7 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </header>

    {postalAnnouncement && (
      <aside class="card operator-postal-alert" aria-label={t(lang, 'postal_changes.title')}>
        <span class="badge badge--accent">2027</span>
        <p>{t(lang, 'operator.postal_alert')}</p>
        <a class="link" href={localePath(lang, '/tarifs-2027')}>{t(lang, 'operator.postal_alert_link')}</a>
      </aside>
    )}

    {lettersAvailable ? (
    <>
    <section class="section op-section" aria-labelledby="dom-letters">
      <h2 id="dom-letters" class="op-section__title">{t(lang, 'operator.domestic_letters')}</h2>
      <RateTable lang={lang} kind="letter" rates={operator.letters.domestic} labelledby="dom-letters" />
    </section>

    <section class="section op-section" aria-labelledby="intl-letters">
      <h2 id="intl-letters" class="op-section__title">{t(lang, 'operator.international_letters')}</h2>
      {operator.letters.international.zones.map((zone, i) => (
        <div class="op-zone">
          <h3 id={`intl-letters-${i}`}>{t(lang, 'operator.zone')}: {zone.name}</h3>
          <p class="op-zone__countries">
            <span class="sr-only">{t(lang, 'ui.zone_countries')}: </span>
            {zone.countries.map((c) => countryName(c)).join(', ')}
          </p>
          <RateTable lang={lang} kind="letter" rates={zone.rates} labelledby={`intl-letters-${i}`} />
        </div>
      ))}
    </section>
    </>
    ) : (
      <section class="section op-section" aria-labelledby="letters-unavailable">
        <h2 id="letters-unavailable" class="op-section__title">{t(lang, 'operator.letters_unavailable_title')}</h2>
        <div class="card op-unavailable">
          <p class="op-unavailable-notice">{operator.letters.notice?.[lang]}</p>
          {operator.letters.unavailable_since && (
            <p class="op-unavailable-notice__date muted">
              {t(lang, 'operator.unavailable_since', { date: formatDate(lang, operator.letters.unavailable_since) })}
            </p>
          )}
        </div>
      </section>
    )}

    <section class="section op-section" aria-labelledby="dom-parcels">
      <h2 id="dom-parcels" class="op-section__title">{t(lang, 'operator.domestic_parcels')}</h2>
      <RateTable lang={lang} kind="parcel" rates={operator.parcels.domestic} labelledby="dom-parcels" />
    </section>

    <section class="section op-section" aria-labelledby="intl-parcels">
      <h2 id="intl-parcels" class="op-section__title">{t(lang, 'operator.international_parcels')}</h2>
      {operator.parcels.international.zones.map((zone, i) => (
        <div class="op-zone">
          <h3 id={`intl-parcels-${i}`}>{t(lang, 'operator.zone')}: {zone.name}</h3>
          <p class="op-zone__countries">
            <span class="sr-only">{t(lang, 'ui.zone_countries')}: </span>
            {zone.countries.map((c) => countryName(c)).join(', ')}
          </p>
          <RateTable lang={lang} kind="parcel" rates={zone.rates} labelledby={`intl-parcels-${i}`} />
        </div>
      ))}
    </section>

    {info.sources && info.sources.length > 0 && (
      <section class="section operator-sources" aria-labelledby="operator-sources-title">
        <h2 id="operator-sources-title" class="op-section__title">{t(lang, 'operator.sources_title')}</h2>
        <ul class="operator-sources__list">
          {info.sources.map((source) => (
            <li>
              <a class="link" href={source.url} target="_blank" rel="noopener">{source.title}</a>
              <span class="muted">{t(lang, 'operator.source_retrieved', { date: formatDate(lang, source.retrieved_at) })}</span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="section op-foot btn-row">
      <a href={localePath(lang, `/compare?origin=${info.country}`)} class="btn btn--primary">
        {t(lang, 'operator.compare_cta')}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href={localePath(lang, '/rankings')} class="btn btn--secondary">{t(lang, 'nav.rankings')}</a>
    </div>
  </article>
</BaseLayout>
