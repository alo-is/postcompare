---
// src/pages/[lang]/index.astro — Landing page with hero
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroForm from '../../components/HeroForm.astro';
import { t } from '../../i18n/utils';
import { loadCountries, loadAllOperators, loadPostalChanges } from '../../lib/data-loader';
import { confirmedConsumerCountries } from '../../lib/postal-changes';
import { localePath } from '../../i18n/utils';
import type { Lang } from '../../lib/types';

export function getStaticPaths() {
  return [
    { params: { lang: 'fr' } },
    { params: { lang: 'en' } },
    { params: { lang: 'de' } },
  ];
}

const lang = Astro.params.lang as Lang;
const countries = loadCountries();
const operators = loadAllOperators();

// Countries (not announcements) with confirmed 2027 consumer changes: France has two sources.
const confirmedCountryCount = confirmedConsumerCountries(loadPostalChanges()).length;

// Map country code to operator for links
const countryToOperator = new Map(operators.map(op => [op.operator.country, op.operator]));

const countryName = (code: string): string => {
  const country = countries.find((c) => c.code === code);
  if (!country) return code;
  return country[`name_${lang}` as keyof typeof country] as string;
};

const homeJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "PostCompare.eu",
  "url": "https://postcompare.eu",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Web",
  "description": t(lang, 'site.description'),
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR",
  },
  "featureList": [
    "Compare postal rates across 32 European countries",
    "Letter and parcel price comparison",
    "Domestic and international shipping rates",
  ],
};
---

<BaseLayout
  title={t(lang, 'site.tagline')}
  description={t(lang, 'site.description')}
  lang={lang}
  jsonLd={homeJsonLd}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <h1 class="hero__title" id="hero-title">{t(lang, 'hero.title')}</h1>
        <p class="hero__lead">{t(lang, 'ui.hero_lead')}</p>
        <p class="hero__note">{t(lang, 'hero.subtitle')}</p>
      </div>
      <HeroForm lang={lang} />
    </div>
  </section>

  <aside class="wrap postal-teaser" aria-labelledby="postal-teaser-title">
    <div class="card postal-teaser__card">
      <div class="postal-teaser__text">
        <span class="badge badge--accent">2027</span>
        <h2 id="postal-teaser-title">{t(lang, 'postal_teaser.title')}</h2>
        <p class="muted">{t(lang, 'postal_teaser.text', { count: confirmedCountryCount })}</p>
      </div>
      <a href={localePath(lang, '/tarifs-2027')} class="btn btn--secondary">
        {t(lang, 'postal_teaser.link')}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </aside>

  <section class="section" aria-labelledby="why-title">
    <div class="wrap">
      <div class="section__head">
        <h2 id="why-title">{t(lang, 'how.title')}</h2>
      </div>
      <ol class="why-grid">
        {[1, 2, 3].map((n) => (
          <li class="card why-card">
            <span class="num why-card__n">{String(n).padStart(2, '0')}</span>
            <h3>{t(lang, `how.step${n}_title`)}</h3>
            <p>{t(lang, `how.step${n}_text`)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="countries-title">
    <div class="wrap">
      <div class="section__head">
        <h2 id="countries-title">{t(lang, 'countries_section.title')}</h2>
        <p>{t(lang, 'ui.countries_hint')}</p>
      </div>
      <ul class="country-grid">
        {countries.map((c) => {
          const op = countryToOperator.get(c.code);
          return (
            <li>
              {op ? (
                <a href={localePath(lang, `/operator/${op.id}`)} class="card country-card">
                  <span class="cc">{c.code}</span>
                  <span class="country-card__text">
                    <span class="country-card__name">{countryName(c.code)}</span>
                    <span class="country-card__op">{op.name}</span>
                  </span>
                </a>
              ) : (
                <div class="card country-card">
                  <span class="cc">{c.code}</span>
                  <span class="country-card__text">
                    <span class="country-card__name">{countryName(c.code)}</span>
                  </span>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</BaseLayout>
