---
// src/pages/index.astro — Redirect to the user's preferred language.
// Crawlers follow the meta refresh to /fr/ (the canonical/x-default version);
// the hreflang links expose the other language versions.
import { languages, languageNames } from '../i18n/utils';

const site = Astro.site ?? new URL('https://www.postcompare.eu');
const localeUrl = (lang: string) => new URL(`/${lang}/`, site).href;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PostCompare.eu – Comparateur de tarifs postaux en Europe</title>
    <meta name="description" content="Comparateur gratuit et indépendant des tarifs postaux en Europe : prix du timbre, des lettres et des colis dans 32 pays." />
    <meta name="theme-color" content="#9B2335" />
    <link rel="canonical" href={localeUrl('fr')} />
    {languages.map((l) => (
      <link rel="alternate" hreflang={l} href={localeUrl(l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={localeUrl('fr')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta http-equiv="refresh" content="0;url=/fr/" />
    <script is:inline>
      // Redirect human visitors to their preferred language if supported.
      // Bots keep the static meta refresh to /fr/, consistent with the canonical URL.
      (function () {
        if (/bot|crawl|spider|slurp|facebookexternalhit|embedly|preview/i.test(navigator.userAgent || '')) return;
        var lang = (navigator.language || '').slice(0, 2).toLowerCase();
        var supported = { fr: '/fr/', en: '/en/', de: '/de/' };
        window.location.replace(supported[lang] || '/fr/');
      })();
    </script>
  </head>
  <body>
    <ul>
      {languages.map((l) => (
        <li><a href={`/${l}/`} hreflang={l} lang={l}>{languageNames[l]}</a></li>
      ))}
    </ul>
  </body>
</html>
