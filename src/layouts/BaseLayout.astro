---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, t } from '../i18n/utils';
import type { Lang } from '../lib/types';

export interface Breadcrumb {
  name: string;
  /** Path without the language prefix, e.g. "/about" */
  path: string;
}

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Page-specific JSON-LD node(s); merged into the page's @graph */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Trail after the home page; renders a BreadcrumbList when provided */
  breadcrumbs?: Breadcrumb[];
}

const { title, description, lang, jsonLd, breadcrumbs } = Astro.props;

const site = Astro.site ?? new URL('https://www.postcompare.eu');
const siteUrl = new URL('/', site).href;
const fullTitle = title.includes('PostCompare.eu') ? title : `${title} | PostCompare.eu`;
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImage = new URL('/og-image.png', site).href;

const localeMap: Record<Lang, string> = {
  fr: 'fr_FR',
  en: 'en_GB',
  de: 'de_DE',
};

// Build hreflang paths by swapping the lang prefix
const currentPathWithoutLang = Astro.url.pathname.replace(/^\/(fr|en|de)(?=\/|$)/, '') || '/';
const localizedUrl = (l: Lang, path = currentPathWithoutLang) => {
  const normalized = path === '/' ? '/' : `${path.replace(/\/$/, '')}/`;
  return new URL(`/${l}${normalized}`, site).href;
};

const organizationId = `${siteUrl}#organization`;
const websiteId = `${siteUrl}#website`;

const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": organizationId,
    "name": "PostCompare.eu",
    "url": siteUrl,
    "logo": new URL('/logo-512.png', site).href,
    "description": t(lang, 'footer.tagline'),
    "sameAs": ["https://github.com/alo-is/postcompare"],
  },
  {
    "@type": "WebSite",
    "@id": websiteId,
    "name": "PostCompare.eu",
    "url": siteUrl,
    "description": t(lang, 'site.description'),
    "inLanguage": languages,
    "publisher": { "@id": organizationId },
  },
];

if (breadcrumbs && breadcrumbs.length > 0) {
  const trail = [{ name: t(lang, 'meta.breadcrumb_home'), path: '/' }, ...breadcrumbs];
  graph.push({
    "@type": "BreadcrumbList",
    "itemListElement": trail.map((crumb, index) => ({
      "@type": "ListItem",
      "position": index + 1,
      "name": crumb.name,
      "item": localizedUrl(lang, crumb.path),
    })),
  });
}

const pageNodes = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
for (const node of pageNodes) {
  const { ["@context"]: _context, ...rest } = node;
  graph.push(rest);
}

const structuredData = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large" />
    <meta name="theme-color" content="#9B2335" />

    {/* Canonical URL */}
    <link rel="canonical" href={canonicalURL.href} />

    {/* Hreflang alternate links */}
    {languages.map((l) => (
      <link rel="alternate" hreflang={l} href={localizedUrl(l)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={localizedUrl('fr')} />

    {/* Open Graph */}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeMap[lang]} />
    {languages.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={localeMap[l]} />
    ))}
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="PostCompare.eu" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t(lang, 'meta.og_image_alt')} />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t(lang, 'meta.og_image_alt')} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo-512.png" />
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link href="https://fonts.bunny.net/css?family=playfair-display:400,400i,700,900|source-serif-4:300,400,600,400i&display=swap" rel="stylesheet" />

    {/* JSON-LD: Organization, WebSite, breadcrumbs and page-specific nodes */}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
